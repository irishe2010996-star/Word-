{
  "manifest_version": 3,
  "name": "Word🤓☝️",
  "version": "0.4.3",
  "description": "Click a word to see its English definition while reading.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.dictionaryapi.dev/*", "https://www.dictionaryapi.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "settings.html" },
  "options_page": "settings.html",
  "content_scripts": [{
    "matches": [
      "https://*.z-lib.sk/*",
      "https://*.z-library.sk/*",
      "https://*.z-library.ec/*",
      "https://*.z-library.se/*",
      "https://*.z-library.rs/*",
      "https://*.z-library.do/*",
      "https://*.z-library.gs/*",
      "https://*.z-lib.gs/*"
    ],
    "js": ["word.js", "reader.js"],
    "all_frames": true,
    "match_origin_as_fallback": true,
    "run_at": "document_idle"
  }]
}
